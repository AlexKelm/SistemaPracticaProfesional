{
  "name": "proyecto",
  "version": "1.0.0",
  "description": "Sistema de gestión de órdenes de servicio",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "coverage": "cross-env NODE_ENV=test jest --coverage --runInBand",
    "crear-usuario": "node src/scripts/crearUsuario.js",
    "crear-tecnicos": "node src/scripts/crearTecnicos.js",
    "seed-data": "node src/scripts/seedData.js",
    "check-data": "node src/scripts/checkData.js",
    "lint:audit": "npm audit --production || exit 0"
  },
  "keywords": ["sistema-gestion", "ordenes-servicio", "nodejs", "express", "mysql"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mysql2": "^3.14.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "statements": 75,
        "branches": 65,
        "functions": 85,
        "lines": 75
      }
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
